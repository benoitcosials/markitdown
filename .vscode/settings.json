{
  // ========================================
  // GitHub Copilot - Configuration Optimale
  // ========================================
  
  // Modèle : Claude Sonnet 4.5 (recommandé pour agents autonomes)
  "github.copilot.advanced": {
    "debug.overrideEngine": "claude-sonnet-4.5",
    "inlineSuggest.enable": true
  },
  
  // Activer Copilot Chat pour les agents
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "python": true
  },
  
  // ========================================
  // Python - Configuration Projet MarkItDown
  // ========================================
  
  // Interpréteur Python (ajuster selon votre environnement)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  
  // Ruff : Linter et formatter moderne (10-100x plus rapide que flake8)
  // IMPORTANT : Extension Ruff doit être installée (charliermarsh.ruff)
  "[python]" : {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false,  // Agents formatent manuellement
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  
  // Configuration Ruff (si extension installée)
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "ruff.lint.run": "onType",  // Validation en temps réel pour agents
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.lint.args": [
    "--line-length=79",
    "--extend-ignore=E203,W503,N802,N806"
  ],
  
  // Linters traditionnels (fallback si Ruff non installé)
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.linting.flake8Args": [
    "--max-line-length=79",
    "--extend-ignore=E203,W503"
  ],
  
  // Tests avec pytest
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "packages/markitdown/tests"
  ],
  
  // ========================================
  // Éditeur - Standards PEP 8
  // ========================================
  
  "editor.rulers": [79],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false, // Ne pas auto-formater (conflits possibles)
  
  // ========================================
  // Fichiers - Associations
  // ========================================
  
  "files.associations": {
    "*.md": "markdown",
    "*.agent.md": "markdown",
    "*.instructions.md": "markdown",
    "*.prompt.md": "markdown"
  },
  
  // Exclure certains dossiers de la recherche
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.venv": false // Visible mais pas indexé
  },
  
  // ========================================
  // Git - Configuration
  // ========================================
  
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  
  // ========================================
  // Terminal - PowerShell par défaut
  // ========================================
  
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  
  // ========================================
  // Markdown - Configuration
  // ========================================
  
  "markdown.preview.breaks": true,
  "markdown.preview.typographer": true,
  
  // ========================================
  // Performance - Optimisation
  // ========================================
  
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true
  }
}
